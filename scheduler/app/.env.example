APP_NAME=Scheduleistic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Scheduleistic branding & white-label
# ---------------------------------------------------------------------------
BRAND_PRIMARY="#6366F1"
BRAND_SECONDARY="#2878D0"
BRAND_LOGO=
BRAND_FAVICON=
BRAND_POWERED_BY="Powered by Scheduleistic"
WHITE_LABEL_ENABLED=false
WHITE_LABEL_CUSTOM_DOMAIN=true
WHITE_LABEL_HIDE_POWERED_BY=false

# ---------------------------------------------------------------------------
# Billing (Stripe via Laravel Cashier — wired in Phase 3)
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
# Stripe price IDs for the paid plans (create these in the Stripe dashboard).
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SCALE=

# ---------------------------------------------------------------------------
# Edge proxy / custom-domain TLS (Caddy)
# ---------------------------------------------------------------------------
# Your primary platform domain (gets an eager Let's Encrypt cert).
APP_DOMAIN=app.example.com
# Email used for Let's Encrypt ACME registration.
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# AI caption assistant (Phase 4) — OpenRouter/OpenAI-compatible chat API
# ---------------------------------------------------------------------------
AI_FAKE=false
AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Brain gateway (wpistic-ai-gateway) — optional. Grounds the AI caption
# assistant and the post AI agents (rewrite/hashtags/quality) in this team's
# own shared brand knowledge via the wpistic-ai-gateway Cross-product Brain
# API. Leave BRAIN_GATEWAY_ENABLED=false (default) to run fully ungrounded,
# or set BRAIN_GATEWAY_FAKE=true for a deterministic local stub with no
# network calls (same convention as AI_FAKE / SOCIAL_FAKE). BRAIN_GATEWAY_SECRET
# must match whatever secret the gateway verifies this product against
# (its own SHARED_SECRET_SCHEDULEISTIC if configured, else its shared
# SHARED_SECRET — see that repo's src/auth.ts).
# ---------------------------------------------------------------------------
BRAIN_GATEWAY_ENABLED=false
BRAIN_GATEWAY_URL=
BRAIN_GATEWAY_SECRET=
BRAIN_GATEWAY_FAKE=false

# ---------------------------------------------------------------------------
# Local testing without real social accounts:
# set SOCIAL_FAKE=true to make every network use a fake driver so you can
# connect channels and publish posts end-to-end with NO OAuth credentials.
# ---------------------------------------------------------------------------
SOCIAL_FAKE=false

# ---------------------------------------------------------------------------
# Social provider OAuth credentials. OAuth redirect URL for each provider is:
#   {APP_URL}/channels/callback/{provider}
# Token-based networks (Mastodon, Bluesky, Medium, WordPress) need NO keys here
# — users connect them with a token/app-password in the UI.
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Facebook app also powers Instagram + Threads (override below if separate).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Google Cloud OAuth client powers Google Business + YouTube.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
