# =============================================================================
# Scheduleistic — PRODUCTION environment template
# =============================================================================
# Copy to `.env` on the server and fill in real values. NEVER commit the real
# .env. Generate APP_KEY with:  php artisan key:generate --show
# =============================================================================

APP_NAME=Scheduleistic
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.scheduleistic.com

# Public marketing site (used in emails/links). Served as static files by Caddy.
MARKETING_URL=https://scheduleistic.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (MySQL 8 / MariaDB) -------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=scheduleistic
DB_USERNAME=scheduleistic
# Use a long random password. Must match docker-compose MYSQL_PASSWORD.
DB_PASSWORD=

# --- Redis (cache / queue / session) ----------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leading dot lets the session cookie cover app + any sub-domains you control.
SESSION_DOMAIN=.scheduleistic.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# --- Edge proxy / TLS (Caddy) -----------------------------------------------
APP_DOMAIN=app.scheduleistic.com
MARKETING_DOMAIN=scheduleistic.com
ACME_EMAIL=admin@scheduleistic.com

# --- Mail (transactional) ---------------------------------------------------
# Use a real SMTP provider (Postmark, SES, Mailgun, Resend, etc.).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="hello@scheduleistic.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage (local by default; S3/R2 optional) -----------------------------
FILESYSTEM_DISK=local
# To use S3-compatible storage (AWS S3 / Cloudflare R2), set FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # for Cloudflare R2

# --- Branding / white-label -------------------------------------------------
BRAND_PRIMARY="#00D084"
BRAND_SECONDARY="#8BE7C2"
BRAND_LOGO=
BRAND_FAVICON=
BRAND_POWERED_BY="Powered by Scheduleistic"
WHITE_LABEL_ENABLED=false
WHITE_LABEL_CUSTOM_DOMAIN=true
WHITE_LABEL_HIDE_POWERED_BY=false

# --- Billing (Stripe via Laravel Cashier) -----------------------------------
# Create products/prices in the Stripe dashboard, then paste the price IDs.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SCALE=

# --- AI caption assistant (optional) ----------------------------------------
# Leave AI_API_KEY blank to disable; set AI_FAKE=true for deterministic demos.
AI_FAKE=false
AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# --- Social publishing ------------------------------------------------------
# Keep false in production. Providers without credentials stay hidden in the UI.
SOCIAL_FAKE=false

# OAuth redirect URL pattern: https://app.scheduleistic.com/channels/callback/{provider}
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
