# SOCIALISTIC edge proxy.
#
# Terminates TLS for the platform domain AND every tenant white-label custom
# domain. Custom domains use Caddy's on-demand TLS: before issuing a Let's
# Encrypt certificate for an unknown hostname, Caddy asks the app
# (/tls/check?domain=...) whether that domain is a verified tenant domain.
# This stops attackers from burning ACME rate limits with bogus hostnames.

{
	# ACME registration email for Let's Encrypt.
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://app:8000/tls/check
		interval 2m
		burst 5
	}
}

# Primary platform domain — normal (eager) certificate.
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
}

# Everything else (tenant custom domains) — certificate issued on demand,
# gated by the app's /tls/check approval.
:443 {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:8000
}
