# Scheduleistic edge proxy.
#
# Routes two first-party domains plus every tenant white-label custom domain:
#   {$MARKETING_DOMAIN}  -> static marketing site (scheduleistic.com)
#   {$APP_DOMAIN}        -> Laravel SaaS app      (app.scheduleistic.com)
#   :443 (catch-all)     -> tenant custom domains via on-demand TLS
#
# Custom domains use Caddy's on-demand TLS: before issuing a Let's Encrypt
# certificate for an unknown hostname, Caddy asks the app
# (/tls/check?domain=...) whether that domain is a verified tenant domain.
# This stops attackers from burning ACME rate limits with bogus hostnames.

{
	# ACME registration email for Let's Encrypt.
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://app:8000/tls/check
		interval 2m
		burst 5
	}
}

# Marketing website — lightweight static files (scheduleistic.com).
# The marketing/ directory is mounted read-only at /srv/marketing.
{$MARKETING_DOMAIN} {
	encode zstd gzip
	root * /srv/marketing
	file_server

	# Long-cache immutable hashed assets; let HTML revalidate each load.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header *.html Cache-Control "public, max-age=0, must-revalidate"

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}

# Primary app domain — normal (eager) certificate (app.scheduleistic.com).
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
}

# Everything else (tenant custom domains) — certificate issued on demand,
# gated by the app's /tls/check approval.
:443 {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:8000
}
